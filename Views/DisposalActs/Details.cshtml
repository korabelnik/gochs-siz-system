@model GochsSiz.Models.DisposalAct
@{
    ViewData["Title"] = "Акт " + Model.ActNumber;
}

<h2>Акт утилизации № @Model.ActNumber</h2>
<div class="card p-4">
    <p><b>Дата:</b> @Model.DisposalDate.ToShortDateString()</p>
    <p><b>СИЗ:</b> @Model.SizItem?.Name</p>
    <p><b>Способ:</b> @Model.DisposalMethod</p>
    <p><b>Класс отходов:</b> @Model.WasteClass</p>
    <p><b>Контрагент:</b> @Model.Contractor</p>
    <p><b>Примечание:</b> @Model.Notes</p>
</div>
<a asp-action="Index" class="btn btn-secondary mt-3">← К списку актов</a>